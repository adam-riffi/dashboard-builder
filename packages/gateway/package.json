{
  "name": "@adam-riffi/dash-gateway",
  "version": "0.0.0",
  "description": "Server gateway for embedded dashboards: contract inference, row policies, SQL compilation and caching over Postgres.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam-riffi/dashboard-builder.git",
    "directory": "packages/gateway"
  },
  "homepage": "https://github.com/adam-riffi/dashboard-builder#readme",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit --coverage",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@adam-riffi/dash-core": "workspace:*",
    "jose": "^6.2.13",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
