{
  "name": "@adam-riffi/dash-react",
  "version": "0.0.0",
  "description": "React builder and viewer for live dashboards on your users' own data.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam-riffi/dashboard-builder.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/adam-riffi/dashboard-builder#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./builder": "./src/builder-entry.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./builder": {
        "types": "./dist/builder-entry.d.ts",
        "import": "./dist/builder-entry.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@adam-riffi/dash-core": "workspace:*",
    "@adam-riffi/dash-visuals": "workspace:*",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@tanstack/react-query": "^5.104.1",
    "react-grid-layout": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
