{
  "name": "@adam-riffi/dash-visuals",
  "version": "0.0.0",
  "description": "Visual plugins (KPI, bar, line, table, scatter, map) for the dashboard builder, drawn with ECharts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam-riffi/dashboard-builder.git",
    "directory": "packages/visuals"
  },
  "homepage": "https://github.com/adam-riffi/dashboard-builder#readme",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "world": "node scripts/world.mjs"
  },
  "dependencies": {
    "@adam-riffi/dash-core": "workspace:*",
    "echarts": "^6.1.0",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/topojson-client": "3.1.5",
    "@vitest/coverage-v8": "5.0.5",
    "i18n-iso-countries": "7.14.0",
    "react": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "world-atlas": "2.0.2"
  }
}
