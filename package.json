{
  "name": "dashboard-builder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "bench": "pnpm --filter @dash/demo exec playwright test --grep @bench",
    "record-demo": "node apps/demo/scripts/record-demo.mjs",
    "db:generate": "pnpm --filter @dash/db generate",
    "db:migrate": "pnpm --filter @dash/db migrate",
    "db:seed": "pnpm --filter @dash/db seed",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check . && turbo run typecheck test build && node scripts/check-packages.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "supabase": "2.120.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vercel": "63.1.0",
    "vitest": "5.0.3"
  }
}
