# Transaction-pooler URL for the read-only role dash_reader (server only).
DASH_SOURCE_URL=postgres://dash_reader:password@localhost:54322/postgres
# Transaction-pooler URL for the app role dash_app (server only).
DASH_APP_DATABASE_URL=postgres://dash_app:password@localhost:54322/postgres
# Supabase Auth JWKS endpoint and issuer used to verify user JWTs (server only).
DASH_JWKS_URL=http://localhost:54321/auth/v1/.well-known/jwks.json
DASH_JWT_ISSUER=http://localhost:54321/auth/v1
# Supabase Auth in the browser (non-secret).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Migrations and pg_cron setup (CI secret; session pooler or direct connection).
DATABASE_URL_MIGRATIONS=postgres://postgres:postgres@localhost:54322/postgres
